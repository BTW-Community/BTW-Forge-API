{
  "schemaVersion": 1,
  "id": "betterthannothing",
  "version": "${version}",
  "name": "Better Than Nothing: Forge API Port",
  "description": "The Forge API, allowing mod devs to more easily port Forge mods to BTW",
  "authors": [
    "All of the Forge maintainers at the time of 1.7.10",
    "TheWinABagel (Port)"
  ],
  "contact": {
    "homepage": "https://github.com/BTW-Community/BTW-Forge-API",
    "sources": "https://github.com/BTW-Community/BTW-Forge-API",
    "issues": "https://github.com/BTW-Community/BTW-Forge-API/issues"
  },
  "license": "LGPL",
  "icon": "assets/forge/icon.png",
  "environment": "*",
  "entrypoints": {
    "btw:addon": [
      "btw.community.forge.BTNForgeAddon"
    ]
  },
  "mixins": [
    "btn.mixins.json"
  ],
  "accessWidener": "btn.accesswidener",
  "depends": {
    "fabricloader": ">=0.14.19",
    "minecraft": "1.6.4"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_1150": ["btw/community/forge/extensions/IBlockAccessExtensions"],
      "net/minecraft/class_1158": ["btw/community/forge/extensions/IBlockAccessExtensions"]
    }
  }
}